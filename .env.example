# Leave false until Functions, indexes and rules are deployed together.
VITE_SERVER_MODE=false
VITE_EMULATORS=false
VITE_APP_CHECK_SITE_KEY=
VITE_PORTAL_ENDPOINT=

# Supply ALL six values for a real Firebase project.
# Empty values use demo identifiers for the browser-local demo only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
